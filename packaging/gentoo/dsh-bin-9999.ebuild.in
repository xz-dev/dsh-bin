#
# Template for dsh-bin release-channel ebuilds: scripts/gentoo-ebuild.mjs fills in the release tag and
# the pinned office addon from the releases index, and writes the matching Manifest DIST lines.

EAPI=8

DESCRIPTION="DeepSeek Harness (dsh) built from GitHub source by dsh-bin"
HOMEPAGE="https://github.com/xz-dev/dsh-bin"
MY_TAG="@TAG@"
OFFICE_TAG="@OFFICE_TAG@"
OFFICE_VERSION="@OFFICE_VERSION@"
SRC_URI="
	amd64? ( https://github.com/xz-dev/dsh-bin/releases/download/${MY_TAG}/dsh-linux-x64-baseline.zip -> ${MY_TAG}-linux-x64-baseline.zip )
	arm64? ( https://github.com/xz-dev/dsh-bin/releases/download/${MY_TAG}/dsh-linux-arm64.zip -> ${MY_TAG}-linux-arm64.zip )
	office? ( https://github.com/xz-dev/dsh-bin/releases/download/${OFFICE_TAG}/dsh-addon-office-linux.zip -> ${OFFICE_TAG}-linux.zip )
"
S="${WORKDIR}"

LICENSE="MIT office? ( MPL-2.0 )"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="office"
RESTRICT="strip"
QA_PREBUILT="usr/lib/dsh-bin/*"
BDEPEND="app-arch/unzip"
RDEPEND="dev-vcs/git"

src_unpack() {
	local target
	case ${ARCH} in
		amd64) target=linux-x64-baseline ;;
		arm64) target=linux-arm64 ;;
		*) die "unsupported ARCH ${ARCH}" ;;
	esac
	mkdir root || die
	unzip -q "${DISTDIR}/${MY_TAG}-${target}.zip" -d root || die
	if use office; then
		mkdir -p "root/addons/office/${OFFICE_VERSION}" || die
		unzip -q "${DISTDIR}/${OFFICE_TAG}-linux.zip" -d "root/addons/office/${OFFICE_VERSION}" || die
		# The one installed office version is what the managed launch uses; no record is written.
		touch "root/addons/office/${OFFICE_VERSION}/.usage.lock" || die
	fi
	# The package manager owns this install: dsh update / install, --use and --addon refuse and name portage.
	touch root/.portage.managed.lock || die
}

src_install() {
	# cp -a keeps the archive's modes (launcher, dsh-native, bin/, native addons); doins would reset them.
	mkdir -p "${ED}/usr/lib/dsh-bin" || die
	cp -a root/. "${ED}/usr/lib/dsh-bin/" || die
	dosym -r /usr/lib/dsh-bin/dsh /usr/bin/dsh
}
