{
  "version": "1.0.0",
  "description": "Independent dsh manager; runtimes and addons are managed per user",
  "homepage": "https://github.com/xz-dev/dsh-bin",
  "license": "MIT",
  "bin": "dsh.exe",
  "architecture": {
    "64bit": {
      "url": "https://github.com/xz-dev/dsh-bin/releases/download/manager-v1.0.0/manager-windows-x64.zip",
      "hash": "a360c80662e27fe87ea025202fa1ee2ddb3e6346e0e2afe3f92697d280b2d3e9"
    },
    "arm64": {
      "url": "https://github.com/xz-dev/dsh-bin/releases/download/manager-v1.0.0/manager-windows-arm64.zip",
      "hash": "6dd7c5819df2ffe34125f8ae324ba46ae12c4a0bc7fc0b225dff5fdc1c93a3eb"
    }
  },
  "post_install": [
    "$marker = Join-Path $dir '.dsh-manager-install.json'",
    "try { $fs = [System.IO.FileStream]::new($marker, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write, [System.IO.FileShare]::None) } catch { throw \"dsh: refusing to replace existing $marker; remove it and reinstall\" }",
    "try { $b = [System.Text.UTF8Encoding]::new($false).GetBytes('{\"schema\":1,\"owner\":\"scoop\"}'); $fs.Write($b, 0, $b.Length) } finally { $fs.Dispose() }"
  ]
}
